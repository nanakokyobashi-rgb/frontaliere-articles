{
  "name": "@frontaliereticino/articles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Article content + rendering engine for frontaliereticino.ch, colocated as an npm workspace (issue #4881 Fase 6). See index.ts for the public API and engine/siteShell.ts for the SiteShellContract the host site must inject before rendering.",
  "main": "index.ts",
  "types": "index.ts",
  "sideEffects": false,
  "peerDependencies": {
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "firebase-admin": "^14.5.0",
    "google-trends-api": "^4.9.2",
    "html-entities": "^2.6.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "undici": "^8.11.2"
  },
  "scripts": {
    "test": "node --test 'generator/tests/*.test.mjs'",
    "test:parity": "node generator/tests/parity/run.mjs --check",
    "test:dry-run": "node generator/tests/dry-run-entrypoints.mjs",
    "check:blog-locales": "node scripts/ci/check-blog-locale-completeness.mjs",
    "refresh:border-wait": "node generator/scripts/refresh-border-wait-averages.mjs",
    "refresh:border-wait-window": "node generator/scripts/refresh-border-wait-window.mjs",
    "refresh:events": "node generator/scripts/refresh-events-dataset.mjs",
    "refresh:fuel-cantons": "node generator/scripts/refresh-fuel-cantons.mjs",
    "test:shell-contract": "npx -y tsx@4.23.15 generator/tests/shell-contract-coverage.mjs"
  }
}
